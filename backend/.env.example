# Misma base de datos del chatbot (se abre en modo solo lectura)
DB_URL=jdbc:postgresql://HOST:5432/juanita_db
DB_USERNAME=
DB_PASSWORD=

PUERTO=3001

# Descomentar para que el visor pida login (usuario y clave)
# VISOR_USUARIO=
# VISOR_CLAVE=
# Opcional: mantener las sesiones abiertas aunque se reinicie el backend
# VISOR_SECRETO=

# Opcional: servir también el frontend compilado desde este backend (un solo proceso)
# FRONTEND_DIST=../frontend/dist
