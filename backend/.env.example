# Misma base de datos del chatbot. Las tablas del chatbot se leen en modo solo lectura; el visor solo
# escribe en su propia tabla visor_usuarios (la crea al arrancar)
DB_URL=jdbc:postgresql://HOST:5432/juanita_db
DB_USERNAME=
DB_PASSWORD=

PUERTO=3001

# API del chatbot (api_csjd): estado de las citas en Lolimsa y validación de usuarios
CSJD_API_URL=http://HOST:8081

# Login con usuario y clave de Lolimsa: la misma USUARIOS_API_KEY que en el .env de api_csjd
USUARIOS_API_KEY=
# Administrador permanente: siempre entra, ve el engranaje y no se le puede quitar el acceso (por defecto SOPORTETI)
# VISOR_ADMIN=SOPORTETI

# Opcional: cuenta de respaldo para entrar si Lolimsa o api_csjd no responden (normalmente SOPORTETI)
# VISOR_USUARIO=SOPORTETI
# VISOR_CLAVE=
# Opcional: mantener las sesiones abiertas aunque se reinicie el backend
# VISOR_SECRETO=

# Opcional: servir también el frontend compilado desde este backend (un solo proceso)
# FRONTEND_DIST=../frontend/dist
